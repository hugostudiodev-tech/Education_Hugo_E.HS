{
  "name": "education-hugo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Education Hugo — khoá học miễn phí cho học sinh, sinh viên mọi ngành. Giao diện + nội dung khoá học; API dùng chung với Hugo Studio.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/generate-seo.mjs && npm run build:sdk && node scripts/publish-sdk.mjs",
    "preview": "vite preview",
    "lint": "eslint src packages scripts middleware.js",
    "check:sql-course": "node scripts/checks/check-sql-course.mjs",
    "check:coder-content": "node scripts/checks/check-coder-content.mjs",
    "check:edu-streak": "node scripts/checks/check-edu-streak.mjs",
    "check:all": "npm run lint && npm run check:sql-course && npm run check:coder-content && npm run check:edu-streak && npm run build",
    "build:sdk": "vite build --config sdk/vite.config.js && cd sdk && npm pack --pack-destination ../dist-sdk"
  },
  "dependencies": {
    "@better-auth/passkey": "1.7.10",
    "@dicebear/core": "^10.7.0",
    "@dicebear/styles": "^10.6.0",
    "@rive-app/webgl2": "2.44.2",
    "@sentry/react": "^10.70.0",
    "@tanstack/react-query": "^5.101.4",
    "better-auth": "1.7.10",
    "canvas-confetti": "^1.9.4",
    "framer-motion": "^12.42.2",
    "gsap": "^3.14.2",
    "i18next": "^26.3.4",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^1.23.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.6.0",
    "react-i18next": "^17.0.8",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.2",
    "remark-gfm": "^4.0.1",
    "sql.js": "^1.12.0",
    "web-vitals": "^5.3.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@tailwindcss/typography": "^0.5.20",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.2",
    "eslint": "^9.15.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.7.0",
    "postcss": "^8.5.16",
    "tailwindcss": "^3.4.19",
    "vite": "^8.1.2",
    "vite-plugin-pwa": "^1.3.0"
  },
  "overrides": {
    "query-string": "^9.5.1"
  }
}
